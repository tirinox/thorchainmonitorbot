# ---- 1. Build the Vue frontend ----
FROM node:22-alpine AS frontend

WORKDIR /build
COPY web/dashboard/package.json web/dashboard/package-lock.json ./
RUN npm ci
COPY web/dashboard/ ./
RUN npm run build

# ---- 2. Python API that also serves the built frontend ----
FROM python:3.12-slim AS production

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    DASHBOARD_STATIC_DIR=/dashboard-static

WORKDIR /app

COPY app/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt \
 && pip install discord.py --no-dependencies

COPY app/ /app/
# outside /app, because docker-compose mounts ./app over it
COPY --from=frontend /build/dist /dashboard-static

EXPOSE 8501

CMD ["python", "dashboard_api.py", "/config/config.yaml"]
