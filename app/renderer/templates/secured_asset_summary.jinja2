{% set _width, _height = set_viewport_size(1440, 1180) %}
{% extends "base.jinja2" %}

{% block content %}
{% set prev = previous or {} %}
{% set prev_assets = prev.get('assets', {}) %}
{% set names = current.asset_names_sorted %}
{% set total_usd = current.total_value_usd or 1 %}
{% set vault_usd = current.total_vault_usd or 1 %}
{% set max_assets = 6 %}
{% set max_shares = 5 %}
{% set max_bars = 9 %}
{% set palette = ['#33FF99', '#23DCC8', '#f5c518', '#7aa2ff', '#ff7f8a', '#c58bff'] %}
{% set others_color = '#5f7d86' %}
{% set days = ((period_seconds or 86400) / 86400) | round | int %}
{% set period_label = '24H' if days <= 1 else days ~ ' days' %}

{% macro sign_class(v) -%}
  {%- set p = v | float -%}
  {%- if p > 0.05 -%}delta-pos{%- elif p < -0.05 -%}delta-neg{%- else -%}delta-zero{%- endif -%}
{%- endmacro %}
{% macro pct_delta(curr, old, cls='delta') -%}
  {%- if old and curr is not none -%}
    {%- set p = ((curr | float) / (old | float) - 1) * 100 -%}
    {%- if p > 0.05 or p < -0.05 -%}
      <span class="{{ cls }} {{ sign_class(p) }}">{{ '+' if p > 0 else '' }}{{ '%.1f' | format(p) }}%</span>
    {%- endif -%}
  {%- endif -%}
{%- endmacro %}
{% macro int_delta(curr, old, cls='delta') -%}
  {%- if old is not none and curr is not none and curr != old -%}
    {%- set d = (curr | int) - (old | int) -%}
    <span class="{{ cls }} {{ sign_class(d) }}">{{ '+' if d > 0 else '' }}{{ short_money(d, integer=True) }}</span>
  {%- endif -%}
{%- endmacro %}
{% macro pp_delta(curr, old, cls='delta') -%}
  {%- if old is not none -%}
    {%- set d = (curr | float) - (old | float) -%}
    {%- if d > 0.005 or d < -0.005 -%}
      <span class="{{ cls }} {{ sign_class(d * 100) }}">{{ '+' if d > 0 else '' }}{{ '%.2f' | format(d) }} pp</span>
    {%- endif -%}
  {%- endif -%}
{%- endmacro %}
{% macro ticker(name) -%}{{- name.split('.')[-1] -}}{%- endmacro %}

{% set tot = namespace(holders=0, prev_holders=0) %}
{% for n in names %}
  {% set tot.holders = tot.holders + current.assets[n].holders %}
  {% set tot.prev_holders = tot.prev_holders + prev_assets.get(n, current.assets[n]).holders %}
{% endfor %}

<style>
  .period-pill {
    position: absolute; top: 39px; right: 34px;
    padding: 13px 20px; border-radius: 14px;
    background: rgba(18,34,37,.85); border: 1px solid rgba(55,255,173,.16);
    text-align: right; min-width: 280px;
  }
  .period-main { font-size: 26px; font-weight: 700; color: #fff; margin-bottom: 3px; text-transform: uppercase; letter-spacing: .1em; }
  .period-sub { font-size: 17px; color: #97b8b0; text-transform: uppercase; letter-spacing: .08em; }

  .layout { position: absolute; top: 140px; left: 30px; right: 30px; bottom: 50px; display: flex; flex-direction: column; gap: 16px; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .card {
    padding: 18px 22px 16px; border-radius: 18px;
    background: linear-gradient(180deg, rgba(18,29,35,.94), rgba(10,16,21,.95));
    border: 1px solid rgba(255,255,255,.05);
  }
  .card-title { color: #91a3a9; font-size: 19px; text-transform: uppercase; letter-spacing: .14em; margin-bottom: 9px; white-space: nowrap; }
  .card-value-row { display: flex; align-items: flex-end; gap: 12px; white-space: nowrap; }
  .card-value { color: #fff; font-size: 48px; font-weight: 800; line-height: 1; text-shadow: rgba(35,220,200,.14) 0 0 16px; }
  .card-sub { margin-top: 9px; font-size: 21px; color: #9eb3ba; white-space: nowrap; }
  .card-sub b { color: #dbe6ea; font-weight: 700; }
  .delta { font-size: 25px; font-weight: 800; letter-spacing: .03em; padding-bottom: 4px; }
  .delta-pos { color: #33FF99; text-shadow: rgba(51,255,153,.22) 0 0 14px; }
  .delta-neg { color: #ff7f8a; text-shadow: rgba(255,127,138,.22) 0 0 14px; }
  .delta-zero { color: #9ca7ad; }

  .content-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; flex: 1; min-height: 0; }
  .panel {
    border-radius: 20px; padding: 18px 22px 16px;
    background: linear-gradient(180deg, rgba(15,24,30,.97), rgba(9,14,19,.98));
    border: 1px solid rgba(255,255,255,.05); min-height: 0;
    display: flex; flex-direction: column;
  }
  .panel-title { color: #fff; font-size: 27px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 6px; }
  .panel-title small { font-size: 18px; color: #8ea4ab; font-weight: 400; margin-left: 10px; letter-spacing: .06em; }

  .assets-list { display: flex; flex-direction: column; gap: 7px; margin-top: 8px; }
  .asset-row {
    display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 12px; align-items: center;
    padding: 8px 14px 8px 8px; border-radius: 14px;
    background: rgba(255,255,255,.03); border-left: 4px solid transparent;
  }
  .asset-logo { width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgba(156,161,159,.4); }
  .asset-name { color: #fff; font-size: 25px; font-weight: 800; letter-spacing: .03em; line-height: 1.1; white-space: nowrap; }
  .asset-sub { color: #8ea4ab; font-size: 17px; margin-top: 2px; white-space: nowrap; }
  .asset-sub b { color: #cfe9e1; font-weight: 700; }
  .asset-right { text-align: right; white-space: nowrap; }
  .asset-value { color: #fff; font-size: 26px; font-weight: 800; line-height: 1.1; }
  .asset-delta { font-size: 17px; font-weight: 700; margin-top: 2px; min-height: 20px; }
  .others-badge {
    width: 46px; height: 46px; border-radius: 50%;
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);
    color: #8ea4ab; font-size: 16px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .asset-row-others .asset-name { color: #8ea4ab; font-style: italic; }

  .shares { margin-top: auto; padding-top: 12px; }
  .shares-label { font-size: 16px; color: #6ae9e0; text-transform: uppercase; letter-spacing: .12em; margin-bottom: 7px; }
  .shares-bar { display: flex; height: 22px; border-radius: 8px; overflow: hidden; gap: 2px; background: rgba(255,255,255,.04); }
  .shares-seg { height: 100%; min-width: 3px; }
  .shares-legend { display: flex; flex-wrap: wrap; gap: 5px 18px; margin-top: 9px; font-size: 19px; color: #b4c4c9; }
  .shares-legend span { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
  .shares-legend b { color: #fff; font-weight: 700; }
  .legend-dot { width: 14px; height: 14px; border-radius: 4px; flex-shrink: 0; display: inline-block; }

  .hint { color: #8ea4ab; font-size: 17px; margin-bottom: 12px; }
  .bars { display: flex; flex-direction: column; gap: 11px; flex: 1; justify-content: space-around; }
  .bar-row { display: grid; grid-template-columns: 40px 130px minmax(0, 1fr) 84px; align-items: center; gap: 12px; }
  .bar-logo { width: 38px; height: 38px; border-radius: 50%; }
  .bar-name { color: #fff; font-size: 21px; font-weight: 800; white-space: nowrap; overflow: hidden; }
  .bar-name small { display: block; color: #6f878e; font-size: 14px; font-weight: 600; letter-spacing: .06em; }
  .bar-track { height: 26px; border-radius: 9px; background: rgba(255,255,255,.05); overflow: hidden; position: relative; }
  .bar-fill {
    height: 100%; border-radius: 9px;
    background: linear-gradient(90deg, rgba(35,220,200,.35), #33FF99);
    box-shadow: 0 0 14px rgba(51,255,153,.35);
  }
  .bar-pct { color: #33FF99; font-size: 23px; font-weight: 800; text-align: right; text-shadow: rgba(51,255,153,.25) 0 0 12px; }

  .backing {
    display: grid; grid-template-columns: auto repeat(3, minmax(0, 1fr)); align-items: center;
    padding: 14px 22px; border-radius: 16px;
    background: linear-gradient(180deg, rgba(18,29,35,.94), rgba(10,16,21,.95));
    border: 1px solid rgba(55,255,173,.16);
  }
  .backing-badge { display: flex; flex-direction: column; gap: 3px; padding-right: 28px; border-right: 1px solid rgba(255,255,255,.07); white-space: nowrap; }
  .backing-title { color: #33FF99; font-size: 24px; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; }
  .backing-hint { font-size: 16px; color: #8ea4ab; }
  .backing-cell { padding: 0 24px; border-right: 1px solid rgba(255,255,255,.06); position: relative; }
  .backing-cell:last-child { border-right: none; }
  .backing-label { font-size: 18px; color: #9eb3ba; text-transform: uppercase; letter-spacing: .09em; margin-bottom: 4px; white-space: nowrap; }
  .backing-value { font-size: 34px; color: #fff; font-weight: 800; line-height: 1; white-space: nowrap; }
  .backing-value small { font-size: 19px; color: #8ea4ab; font-weight: 600; }
  .backing-value.accent { color: #33FF99; text-shadow: rgba(51,255,153,.3) 0 0 14px; }
</style>

{% with title="SECURED ASSETS" %}
  {% include "components/header.jinja2" %}
{% endwith %}

<div class="period-pill shadow-box">
  <div class="period-main">Last {{ period_label }}</div>
  <div class="period-sub">Secured on THORChain</div>
</div>

<div class="layout">

  <div class="stats-grid">
    <div class="card shadow-box">
      <div class="card-title">💰 Secured value</div>
      <div class="card-value-row">
        <div class="card-value">{{ short_dollar(current.total_value_usd) }}</div>
        {{ pct_delta(current.total_value_usd, prev.get('total_value_usd')) }}
      </div>
      <div class="card-sub">in <b>{{ current.total_assets }}</b> secured assets {{ int_delta(current.total_assets, prev.get('total_assets'), 'asset-delta') }}</div>
    </div>
    <div class="card shadow-box">
      <div class="card-title">👥 Holders</div>
      <div class="card-value-row">
        <div class="card-value">{{ short_money(tot.holders, integer=True) }}</div>
        {{ int_delta(tot.holders, tot.prev_holders if prev else none) }}
      </div>
      <div class="card-sub">holdings across all assets</div>
    </div>
    <div class="card shadow-box">
      <div class="card-title">🛡 Of pool depth</div>
      <div class="card-value-row">
        <div class="card-value">{{ '%.1f' | format(current.total_secured_to_pool_percentage) }}%</div>
        {{ pp_delta(current.total_secured_to_pool_percentage, prev.get('total_secured_to_pool_percentage')) }}
      </div>
      <div class="card-sub">of <b>{{ short_dollar(current.total_pool_usd) }}</b> in the pools</div>
    </div>
    <div class="card shadow-box">
      <div class="card-title">📈 Volume 24h</div>
      <div class="card-value-row">
        <div class="card-value">{{ short_dollar(current.total_volume_24h_usd) }}</div>
        {{ pct_delta(current.total_volume_24h_usd, prev.get('total_volume_24h_usd')) }}
      </div>
      <div class="card-sub">swaps of secured assets</div>
    </div>
  </div>

  <div class="content-row">

    <div class="panel shadow-box">
      <div class="panel-title">🏆 Top secured assets</div>
      <div class="assets-list">
        {% for n in names[:max_assets] %}
          {% set a = current.assets[n] %}
          {% set pa = prev_assets.get(n, {}) %}
          <div class="asset-row" style="border-left-color: {{ palette[loop.index0] if loop.index0 < max_shares else 'transparent' }}">
            <img class="asset-logo" src="renderer/logo/{{ a.l1_name }}.png" onerror="this.src='renderer/logo/unknown.png'">
            <div>
              <div class="asset-name">{{ a.display_name }}</div>
              <div class="asset-sub">
                <b>{{ short_money(a.supply) }}</b> {{ ticker(a.display_name) }} ·
                <b>{{ short_money(a.holders, integer=True) }}</b> holder{{ '' if a.holders == 1 else 's' }}
                {{ int_delta(a.holders, pa.get('holders'), 'asset-delta') }}
              </div>
            </div>
            <div class="asset-right">
              <div class="asset-value">{{ short_dollar(a.value_usd) }}</div>
              <div class="asset-delta">{{ pct_delta(a.value_usd, pa.get('value_usd'), 'asset-delta') }}</div>
            </div>
          </div>
        {% endfor %}
        {% set rest = names[max_assets:] %}
        {% if rest %}
          {% set o = namespace(v=0.0, pv=0.0, h=0) %}
          {% for n in rest %}
            {% set a = current.assets[n] %}
            {% set o.v = o.v + a.value_usd %}
            {% set o.pv = o.pv + prev_assets.get(n, a).value_usd %}
            {% set o.h = o.h + a.holders %}
          {% endfor %}
          <div class="asset-row asset-row-others">
            <div class="others-badge">+{{ rest | length }}</div>
            <div>
              <div class="asset-name">{{ rest | length }} others</div>
              <div class="asset-sub"><b>{{ short_money(o.h, integer=True) }}</b> holder{{ '' if o.h == 1 else 's' }}</div>
            </div>
            <div class="asset-right">
              <div class="asset-value">{{ short_dollar(o.v) }}</div>
              <div class="asset-delta">{{ pct_delta(o.v, o.pv, 'asset-delta') }}</div>
            </div>
          </div>
        {% endif %}
      </div>

      {% set ts = namespace(sum=0.0) %}
      <div class="shares">
        <div class="shares-label">Share of value</div>
        <div class="shares-bar">
          {% for n in names[:max_shares] %}
            {% set s = current.assets[n].value_usd / total_usd * 100 %}
            {% set ts.sum = ts.sum + s %}
            <div class="shares-seg" style="width: {{ s }}%; background: {{ palette[loop.index0] }}"></div>
          {% endfor %}
          <div class="shares-seg" style="flex: 1; background: {{ others_color }}"></div>
        </div>
        <div class="shares-legend">
          {% for n in names[:max_shares] %}
            <span><i class="legend-dot" style="background: {{ palette[loop.index0] }}"></i><b>{{ '%.0f' | format(current.assets[n].value_usd / total_usd * 100) }}%</b> {{ ticker(current.assets[n].display_name) }}</span>
          {% endfor %}
          <span><i class="legend-dot" style="background: {{ others_color }}"></i><b>{{ '%.0f' | format(100 - ts.sum) }}%</b> others</span>
        </div>
      </div>
    </div>

    <div class="panel shadow-box">
      <div class="panel-title">🛡 Secured of the pool</div>
      <div class="hint">How much of each L1 pool is already secured on THORChain</div>
      {% set ranked = [] %}
      {% for n in names[:16] %}{% set _ = ranked.append(current.assets[n]) %}{% endfor %}
      {% set ranked = ranked | sort(attribute='secured_to_pool_percentage', reverse=True) %}
      {% set top_pct = [ranked[0].secured_to_pool_percentage if ranked else 1, 1] | max %}
      <div class="bars">
        {% for a in ranked[:max_bars] %}
          <div class="bar-row">
            <img class="bar-logo" src="renderer/logo/{{ a.l1_name }}.png" onerror="this.src='renderer/logo/unknown.png'">
            <div class="bar-name">{{ ticker(a.display_name) }}<small>{{ a.display_name.split('.')[0] }}</small></div>
            <div class="bar-track"><div class="bar-fill" style="width: {{ [a.secured_to_pool_percentage / top_pct * 100, 2] | max }}%"></div></div>
            <div class="bar-pct">{{ '%.1f' | format(a.secured_to_pool_percentage) }}%</div>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>

  <div class="backing shadow-box">
    <div class="backing-badge">
      <div class="backing-title">🏦 Backing</div>
      <div class="backing-hint">L1 coins behind the network</div>
    </div>
    <div class="backing-cell">
      <div class="backing-label">Asgard vaults</div>
      <div class="backing-value">{{ short_dollar(current.total_vault_usd) }}</div>
    </div>
    <div class="backing-cell">
      <div class="backing-label">In the pools</div>
      <div class="backing-value">{{ short_dollar(current.total_pool_usd) }} <small>{{ '%.0f' | format(current.total_pool_usd / vault_usd * 100) }}% of vaults</small></div>
    </div>
    <div class="backing-cell">
      <div class="backing-label">Secured</div>
      <div class="backing-value accent">{{ short_dollar(current.total_value_usd) }} <small>{{ '%.1f' | format(current.total_value_usd / vault_usd * 100) }}% of vaults</small></div>
    </div>
  </div>

</div>
{% endblock %}
