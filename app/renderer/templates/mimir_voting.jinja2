{% set _width, _height = set_viewport_size(1920, 1080) %}
{% extends "base.jinja2" %}

{# The progress of a Mimir vote: the question as a headline, one wide split bar of all the votes with the 2/3 mark, a big card per option, the dates and a small chart in a strip at the bottom #}
{% block content %}
    <style>
        .wrap {
            position: absolute;
            top: 135px;
            left: 56px;
            right: 56px;
            bottom: 50px;
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        .panel {
            border-radius: 20px;
            background: linear-gradient(180deg, rgba(18, 29, 35, .94), rgba(10, 16, 21, .95));
            border: 1px solid rgba(255, 255, 255, .05);
            padding: 22px 30px;
            min-width: 0;
            min-height: 0;
        }

        .label {
            font-size: 20px;
            text-transform: uppercase;
            letter-spacing: 0.18em;
            color: #91a3a9;
            font-weight: 300;
        }

        /* headline */
        .head {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .head-q {
            flex: 1;
            min-width: 0;
        }

        .q-name {
            font-size: 60px;
            font-weight: 700;
            color: #fff;
            line-height: 1.05;
            text-shadow: rgba(35, 220, 200, .15) 0 0 18px;
        }

        .q-key {
            margin-top: 6px;
            font-size: 24px;
            color: #7f949b;
            letter-spacing: 0.06em;
        }

        .q-key b {
            color: #c8d6da;
            font-weight: 600;
        }

        .pill {
            flex: none;
            padding: 18px 30px;
            border-radius: 999px;
            border: 1px solid rgba(255, 220, 90, .4);
            background: rgba(255, 220, 90, .08);
            color: #FFDC5A;
            font-size: 30px;
            font-weight: 800;
            letter-spacing: .06em;
            text-align: center;
        }

        .pill small {
            display: block;
            font-size: 19px;
            font-weight: 400;
            color: #d9c98a;
            letter-spacing: .02em;
            margin-top: 2px;
        }

        .pill.reached {
            border-color: rgba(51, 255, 153, .5);
            background: rgba(51, 255, 153, .1);
            color: #33FF99;
        }

        .pill.reached small {
            color: #9fe9c4;
        }

        /* split bar */
        .split {
            padding-top: 48px;
        }

        .split-track {
            position: relative;
            height: 64px;
            border-radius: 14px;
            overflow: visible;
            background: rgba(255, 255, 255, .06);
            display: flex;
        }

        .seg {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 800;
            color: #061913;
            overflow: hidden;
            white-space: nowrap;
        }

        .seg:first-child {
            border-radius: 14px 0 0 14px;
        }

        .seg.none {
            background: repeating-linear-gradient(135deg, #3a444b 0 10px, #2e373d 10px 20px);
            color: #aab;
            border-radius: 0 14px 14px 0;
            margin-left: auto;
        }

        .split-mark {
            position: absolute;
            top: -12px;
            bottom: -12px;
            width: 4px;
            margin-left: -2px;
            background: #FFDC5A;
            box-shadow: 0 0 14px rgba(255, 220, 90, .7);
            border-radius: 2px;
        }

        .split-mark-label {
            position: absolute;
            top: -44px;
            transform: translateX(-50%);
            font-size: 20px;
            letter-spacing: .1em;
            color: #FFDC5A;
            white-space: nowrap;
        }

        /* cards */
        .cards {
            flex: 1;
            display: flex;
            gap: 22px;
            min-height: 0;
        }

        .card {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 10px;
            border-top: 8px solid;
            min-width: 0;
        }

        .card.lead {
            background: linear-gradient(180deg, rgba(35, 220, 200, .10), rgba(10, 16, 21, .95));
        }

        .card.none {
            flex: .6;
            opacity: .55;
        }

        .card-name {
            font-size: 38px;
            font-weight: 700;
            color: #fff;
            line-height: 1.1;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-pct {
            font-size: 96px;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -.02em;
        }

        .card.none .card-pct {
            font-size: 64px;
            color: #aab;
        }

        .card-count {
            font-size: 26px;
            color: #9fb1b7;
        }

        .card-tag {
            align-self: flex-start;
            font-size: 16px;
            letter-spacing: .14em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, .18);
            color: #aab;
        }

        /* bottom strip */
        .strip {
            flex: none;
            height: 230px;
            display: flex;
            gap: 22px;
        }

        .meta {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 6px;
        }

        .meta-val {
            font-size: 34px;
            font-weight: 700;
            color: #eef6f8;
            line-height: 1.1;
        }

        .meta-sub {
            font-size: 20px;
            color: #23DCC8;
            opacity: .85;
        }

        .chart {
            flex: 2;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .chart-area {
            flex: 1;
            position: relative;
            min-height: 0;
        }
    </style>

    {% with title="MIMIR VOTE" %}
        {% include "components/header.jinja2" %}
    {% endwith %}

    <div class="wrap">
        <div class="panel head shadow-box">
            <div class="head-q">
                <div class="q-name">{{ pretty_name or key_display or key }}</div>
                <div class="q-key">Mimir key <b>{{ key_display or key }}</b><span id="current-val"></span></div>
            </div>
            <div class="pill" id="pill"><span id="status-title"></span><small id="status-detail"></small></div>
        </div>

        <div class="panel split shadow-box">
            <div class="split-track" id="split"></div>
        </div>

        <div class="cards" id="cards"></div>

        <div class="strip">
            <div class="panel meta shadow-box">
                <div class="label">Voting started</div>
                <div class="meta-val" id="first-seen"></div>
                <div class="meta-sub" id="first-ago"></div>
            </div>
            <div class="panel meta shadow-box">
                <div class="label">Last vote</div>
                <div class="meta-val" id="last-seen"></div>
                <div class="meta-sub" id="last-ago"></div>
            </div>
            <div class="panel meta shadow-box">
                <div class="label">Participation</div>
                <div class="meta-val" id="voted-line"></div>
                <div class="meta-sub" id="voted-sub"></div>
            </div>
            <div class="panel chart shadow-box">
                <div class="label">History</div>
                <div class="chart-area"><canvas id="historyChart"></canvas></div>
            </div>
        </div>
    </div>

    {% include "components/vote_data.jinja2" %}
    <script>
        if (currentValueText) setHtml('current-val', ` &nbsp;·&nbsp; now <b>${currentValueText}</b>`);
        if (reached) document.getElementById('pill').classList.add('reached');
        setHtml('status-title', (reached ? '✓ ' : '') + consensusStatus.title);
        setHtml('status-detail', consensusStatus.detail);
        setHtml('first-seen', fmtTs(firstSeenTs));
        setHtml('first-ago', fmtAgo(firstSeenTs));
        setHtml('last-seen', fmtTs(lastSeenTs));
        setHtml('last-ago', fmtAgo(lastSeenTs));
        setHtml('voted-line', `${votedCount} of ${activeNodes}`);
        setHtml('voted-sub', `${fmtPct(votedCount)} of nodes voted`);

        const split = document.getElementById('split');
        const consensusPct = CONSENSUS * 100;
        options.forEach(o => {
            const seg = document.createElement('div');
            seg.className = 'seg';
            seg.style.width = `${pctOf(o.count)}%`;
            seg.style.background = o.color;
            seg.textContent = pctOf(o.count) >= 7 ? fmtPct(o.count) : '';
            split.appendChild(seg);
        });
        if (abstainedNodes > 0) {
            const seg = document.createElement('div');
            seg.className = 'seg none';
            seg.style.width = `${pctOf(abstainedNodes)}%`;
            seg.textContent = pctOf(abstainedNodes) >= 7 ? fmtPct(abstainedNodes) : '';
            split.appendChild(seg);
        }
        split.insertAdjacentHTML('beforeend',
            `<div class="split-mark" style="left:${consensusPct}%"></div>
             <div class="split-mark-label" style="left:${consensusPct}%">2/3 consensus · ${consensusCount} nodes</div>`);

        const cards = document.getElementById('cards');
        [...options, ...(abstainedNodes > 0 ? [notVoted] : [])].forEach((o, i) => {
            const card = document.createElement('div');
            card.className = 'panel card shadow-box' + (i === 0 && reached ? ' lead' : '') + (o === notVoted ? ' none' : '');
            card.style.borderTopColor = o.color;
            card.innerHTML = `
                <div class="card-name">${i === 0 && reached ? '✓ ' : ''}${o.name}</div>
                <div class="card-pct" style="color:${o.color}">${fmtPct(o.count)}</div>
                <div class="card-count">${o.count} of ${activeNodes} nodes</div>
                ${o.isCurrent ? '<span class="card-tag">current value</span>' : ''}`;
            cards.appendChild(card);
        });

        drawHistoryChart('historyChart', {fontSize: 17});
    </script>
{% endblock %}
