{% set _width, _height = set_viewport_size(1024, 1024) %}
{% extends "base.jinja2" %}

{% block content %}
    ## The wreath is drawn smaller than the card to leave room for the title and the stats under it
    {% set bg_size = frame_size | default(860) %}
    {% set bg_top = frame_top | default(40) %}
    {% set shade = shade_from | default(58) %}
    ## the card continues the background picture: its color is the one at the picture edges
    {% set base = base_color | default('#0a1015') %}
    {% set fade = 10 %}
    ## the wreath hole on the card, px
    {% set hole_cx = 512 + (hole_x - 0.5) * bg_size %}
    {% set hole_cy = bg_top + hole_y * bg_size %}
    {% set hole_radius = hole_r * bg_size %}

    <style>
        :root {
            --tint: {{ tint }};
            --tint-soft: color-mix(in srgb, var(--tint) 45%, transparent);
            --tint-faint: color-mix(in srgb, var(--tint) 14%, transparent);
        }

        .container.bg {
            background: radial-gradient(circle at {{ (hole_cx / 10.24) | round(1) }}% {{ (hole_cy / 10.24) | round(1) }}%, var(--tint-faint), transparent 55%),
            {{ base }};
        }

        .ach-bg {
            position: absolute;
            left: 50%;
            top: {{ bg_top }}px;
            width: {{ bg_size }}px;
            height: {{ bg_size }}px;
            transform: translateX(-50%);
            /* only the picture edges fade, into the card color taken from them: the picture flows into the card */
            -webkit-mask-image: linear-gradient(to right, transparent, #000 {{ fade }}%, #000 {{ 100 - fade }}%, transparent),
            linear-gradient(to bottom, transparent, #000 {{ fade }}%, #000 {{ 100 - fade }}%, transparent);
            -webkit-mask-composite: source-in;
            mask-image: linear-gradient(to right, transparent, #000 {{ fade }}%, #000 {{ 100 - fade }}%, transparent),
            linear-gradient(to bottom, transparent, #000 {{ fade }}%, #000 {{ 100 - fade }}%, transparent);
            mask-composite: intersect;
        }

        .ach-shade {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, transparent {{ shade }}%, color-mix(in srgb, {{ base }} 82%, transparent) {{ shade + 18 }}%, {{ base }} {{ shade + 32 }}%);
        }

        .ach-brand {
            position: absolute;
            top: 26px;
            left: 0;
            right: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .ach-brand-row {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .ach-brand-row img {
            height: 40px;
        }

        .ach-brand-name {
            font-size: 30px;
            font-weight: 600;
            letter-spacing: 0.3em;
            color: #e6ecef;
            text-shadow: 0 0 8px #000, 0 0 3px #000; /* readable over sparks of the background */
        }

        .ach-date {
            font-size: 18px;
            font-weight: 500;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--tint);
            opacity: 0.9;
            text-shadow: 0 0 8px #000, 0 0 3px #000, 0 0 1px #000;
        }

        @font-face {
            font-family: NorseBold;
            src: url(renderer/static/fonts/NorseBold.otf);
        }

        /* the number itself sits in the middle of the hole; its label hangs above it */
        .ach-number-box {
            position: absolute;
            left: {{ hole_cx }}px;
            top: {{ hole_cy }}px;
            transform: translate(-50%, -50%);
        }

        .ach-number-label {
            position: absolute;
            left: 50%;
            bottom: 100%;
            transform: translateX(-50%);
            margin-bottom: 2px;
            white-space: nowrap;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: #fff;
            text-shadow: 0 0 10px var(--tint), 0 0 2px #000;
        }

        /* the number: Norse Bold in polished metal of the frame color. A gradient face can not carry a shadow,
           so the element itself is the shadow and glow, and the face lies over it as ::after */
        .ach-number {
            position: relative;
            font-family: NorseBold, ThorFont, sans-serif;
            font-size: 170px; /* grown or shrunk to the hole by fitNumber() */
            line-height: 0.9;
            letter-spacing: 0.02em;
            white-space: nowrap;
            padding: 0 0.04em;
            color: transparent;
            text-shadow: 0 0.035em 0.02em #000, 0 0 0.12em var(--tint-soft), 0 0 0.3em var(--tint-soft);
        }

        .ach-number::after {
            content: attr(data-text);
            position: absolute;
            inset: 0;
            padding: inherit;
            background-image: linear-gradient(180deg,
            #ffffff 0%,
            color-mix(in srgb, var(--tint) 30%, #fff) 36%,
            var(--tint) 50%,
            color-mix(in srgb, var(--tint) 55%, #000) 66%,
            color-mix(in srgb, var(--tint) 75%, #fff) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: none; /* inherited, it would cover the gradient */
            -webkit-text-stroke: 0.012em color-mix(in srgb, var(--tint) 30%, #000);
        }

        /* the anniversary keeps its balloon digits */
        .ach-number.balloon {
            display: flex;
            align-items: center;
            gap: 0.05em;
            font-size: 300px; /* fitted by fitNumber(): a balloon digit may float a bit over the ring */
            line-height: 1;
            padding: 0;
            text-shadow: none;
        }

        .ach-number.balloon::after {
            content: none;
        }

        .ach-number.balloon img {
            height: 1em;
            display: block;
            filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.6));
        }

        .ach-bottom {
            position: absolute;
            left: 36px;
            right: 36px;
            bottom: 42px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 18px;
        }

        .ach-bottom.no-stats {
            bottom: 90px;
        }

        .ach-title-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 18px;
            max-width: 100%;
        }

        .ach-asset-logo {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            flex-shrink: 0;
            filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.25));
        }

        .ach-title {
            font-size: 50px;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            text-align: center;
            color: #fff;
            text-shadow: 0 0 18px var(--tint-soft), 0 2px 2px rgba(0, 0, 0, 0.8);
            min-width: 0;
        }

        .ach-subtitle {
            font-size: 30px;
            font-weight: 600;
            color: var(--tint);
            margin-top: -6px;
        }

        .ach-stats {
            display: grid;
            grid-template-columns: repeat({{ stats | length }}, 1fr);
            width: 100%;
            padding: 16px 8px;
            border-radius: 20px;
            border: 1px solid color-mix(in srgb, var(--tint) 30%, transparent);
            background: rgba(12, 20, 26, 0.78);
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
        }

        .ach-stat {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
            padding: 0 12px;
            min-width: 0;
        }

        .ach-stat + .ach-stat {
            border-left: 1px solid rgba(255, 255, 255, 0.1);
        }

        .ach-stat-label {
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: #8f9aa1;
        }

        .ach-stat-value {
            font-size: 34px;
            font-weight: 700;
            color: #fff;
            white-space: nowrap;
        }

        .ach-stat-sub {
            font-size: 18px;
            color: #8f9aa1;
        }
    </style>

    <img class="ach-bg" src="renderer/static/img/achievement/bg/{{ background }}" alt="">
    <div class="ach-shade"></div>

    <div class="ach-brand">
        <div class="ach-brand-row">
            <img src="renderer/static/img/tc_logo_transparent.png?rv=1" alt="THORChain logo">
            <div class="ach-brand-name">THORCHAIN</div>
        </div>
        <div class="ach-date">{{ date }}</div>
    </div>

    <div class="ach-number-box" id="ach-number-box">
        {% if number_label %}
            <div class="ach-number-label">{{ number_label }}</div>
        {% endif %}
        {% if number_font == 'balloon' %}
            <div class="ach-number balloon" id="ach-number">
                {% for g in glyphs %}
                    <img src="renderer/static/img/achievement/{{ g.src }}" alt="">
                {% endfor %}
            </div>
        {% else %}
            <div class="ach-number" id="ach-number" data-text="{{ number_text }}">{{ number_text }}</div>
        {% endif %}
    </div>

    <div class="ach-bottom {{ '' if stats else 'no-stats' }}">
        <div class="ach-title-row">
            {% if asset_logo %}
                <img class="ach-asset-logo" src="renderer/logo/{{ asset_logo }}.png" alt=""
                     onerror="this.style.display='none'">
            {% endif %}
            <div class="ach-title" id="ach-title">{{ title }}</div>
        </div>

        {% if subtitle %}
            <div class="ach-subtitle">{{ subtitle }}</div>
        {% endif %}

        {% if stats %}
            <div class="ach-stats">
                {% for s in stats %}
                    <div class="ach-stat">
                        <div class="ach-stat-label">{{ s.label }}</div>
                        <div class="ach-stat-value">{{ s.value }}</div>
                        {% if s.sub %}
                            <div class="ach-stat-sub">{{ s.sub }}</div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <script>
        // the number and its label sit in the middle of the wreath hole: the number takes the largest size
        // at which every corner of it and its label is inside the hole, with some room left to the ring
        function fitNumber() {
            const cx = {{ hole_cx }}, cy = {{ hole_cy }};
            const balloon = {{ 'true' if number_font == 'balloon' else 'false' }};
            // the number keeps clear of the ring; a balloon digit may float a bit over it
            const maxDistance = {{ hole_radius }} * (balloon ? 1.15 : 0.9);
            const [minSize, maxSize] = balloon ? [80, 420] : [40, 360];
            const box = document.getElementById('ach-number-box');
            const number = document.getElementById('ach-number');
            const label = box.querySelector('.ach-number-label');
            const ctx = document.createElement('canvas').getContext('2d');

            // the glyphs themselves: the line box of Norse Bold has room under the digits and they reach
            // a bit over its top, so a text number is measured and centered by its ink, from the font metrics
            const inkOf = (r) => {
                if (balloon) {
                    return {left: r.left, right: r.right, top: r.top, bottom: r.bottom};
                }
                const cs = getComputedStyle(number);
                ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
                ctx.letterSpacing = cs.letterSpacing;
                const m = ctx.measureText(number.dataset.text);
                const ascent = m.fontBoundingBoxAscent, descent = m.fontBoundingBoxDescent;
                const baseline = r.top + (r.height - ascent - descent) / 2 + ascent;
                const start = r.left + parseFloat(cs.paddingLeft);
                return {
                    left: start - m.actualBoundingBoxLeft, right: start + m.actualBoundingBoxRight,
                    top: baseline - m.actualBoundingBoxAscent, bottom: baseline + m.actualBoundingBoxDescent
                };
            };

            // lays the number out at this size: returns how far its farthest corner is and where it moves to
            const layout = (size) => {
                number.style.fontSize = size + 'px';
                box.style.transform = 'translate(-50%, -50%)';
                const r = number.getBoundingClientRect();
                const ink = inkOf(r);
                const rects = [ink];
                if (label) {
                    // the label grows a little with a big number and hangs just over the ink
                    label.style.fontSize = Math.min(40, Math.max(28, size * 0.165)) + 'px';
                    label.style.marginBottom = (r.top - ink.top + 2) + 'px';
                    rects.push(label.getBoundingClientRect());
                }
                const dx = cx - (ink.left + ink.right) / 2, dy = cy - (ink.top + ink.bottom) / 2;
                const distance = Math.max(...rects.map(q => Math.hypot(
                    Math.max(Math.abs(q.left + dx - cx), Math.abs(q.right + dx - cx)),
                    Math.max(Math.abs(q.top + dy - cy), Math.abs(q.bottom + dy - cy)))));
                return {distance, dx, dy};
            };

            // the label keeps a size of its own, so the distance is not proportional to the size: a bisection
            let lo = minSize, hi = maxSize;
            if (layout(hi).distance <= maxDistance) {
                lo = hi;
            } else {
                while (hi - lo > 0.5) {
                    const mid = (lo + hi) / 2;
                    if (layout(mid).distance <= maxDistance) lo = mid; else hi = mid;
                }
            }
            const {dx, dy} = layout(lo);
            box.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
        }

        // the title: one line if it fits without getting too small, otherwise at most two lines
        function fitTitle() {
            const el = document.getElementById('ach-title');
            const baseSize = parseFloat(getComputedStyle(el).fontSize);
            const overflows = () => el.scrollWidth > el.clientWidth + 1;
            const setSize = (size) => el.style.fontSize = size + 'px';

            let size = baseSize;
            el.style.whiteSpace = 'nowrap';
            while (size > baseSize * 0.76 && overflows()) {
                setSize(size -= 2);
            }
            if (!overflows()) {
                return;
            }

            el.style.whiteSpace = 'normal';
            setSize(size = baseSize);
            while (size > 20 && (overflows() || el.offsetHeight > size * 1.1 * 2 + 4)) {
                setSize(size -= 2);
            }
        }

        // shrink a stat value that does not fit its column
        function fitStats() {
            document.querySelectorAll('.ach-stat-value').forEach(el => {
                let size = parseFloat(getComputedStyle(el).fontSize);
                while (size > 16 && el.scrollWidth > el.parentElement.clientWidth - 24) {
                    size -= 1;
                    el.style.fontSize = size + 'px';
                }
            });
        }

        // the number is measured by the font, so it waits for the fonts
        window.addEventListener('load', () => document.fonts.ready.then(() => {
            fitNumber();
            fitTitle();
            fitStats();
        }));
    </script>
{% endblock %}
